<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.ut.udm08.client.ui.EmojiInput?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.edu.ut.udm08.client.controller.ChatController"
            prefWidth="960" prefHeight="620" styleClass="root-pane" stylesheets="@../css/base.css,@../css/sidebar.css,@../css/chat.css">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <StackPane>
            <VBox styleClass="chat-area">
                <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="12">
                    <padding><Insets top="12" right="18" bottom="12" left="18"/></padding>
                    <StackPane fx:id="chatPartnerAvatar" styleClass="avatar-circle" prefWidth="42" prefHeight="42">
                        <Label fx:id="chatPartnerInitial" text="?" styleClass="avatar-text"/>
                    </StackPane>
                    <Label minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" fx:id="chatPartnerName" text="Chọn một người để chat" styleClass="chat-header-label"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Thông tin" onAction="#showConversationInfo" accessibleText="Thông tin hội thoại"/>
                </HBox>

                <HBox fx:id="connectionBar" visible="false" managed="false" spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #fff4d6;">
                    <Label fx:id="connectionStatus" text="Mất kết nối" wrapText="true" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="reconnectButton" text="Kết nối lại"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER" style="-fx-padding: 3;">
                    <Label fx:id="historyStatus" text=""/>
                    <Button fx:id="historyRetry" text="Thử lại" visible="false" managed="false"/>
                </HBox>
                <ScrollPane fx:id="messageScrollPane" fitToWidth="true" styleClass="message-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="messageContainer" spacing="10">
                        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                    </VBox>
                </ScrollPane>

                <Button fx:id="newestButton" text="↓ Tin nhắn mới" visible="false" managed="false" styleClass="newest-button"/>
                <VBox styleClass="input-bar">
                    <HBox styleClass="toolbar-row" spacing="16" alignment="CENTER_LEFT">
                        <padding><Insets top="8" right="16" bottom="4" left="16"/></padding>
                       <Label fx:id="emojiIcon" text="😊" styleClass="toolbar-icon" onMouseClicked="#handleEmojiButtonClick"/>
                        <Button text="Ảnh / Tệp" onAction="#chooseAttachment" accessibleText="Gửi ảnh hoặc tệp, tối đa 5 MB"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER">
                        <padding><Insets top="0" right="16" bottom="12" left="16"/></padding>
                        <EmojiInput fx:id="messageInput" promptText="Nhập tin nhắn… (Shift+Enter để xuống dòng)" styleClass="message-input" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="sendButton" text="Gửi" styleClass="send-button" onAction="#handleSend"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox fx:id="emptyStatePane" styleClass="empty-state" alignment="CENTER" spacing="10">
                <Label text="UDM" styleClass="empty-state-brand"/>
                <Label text="Chọn một cuộc trò chuyện" styleClass="empty-state-title"/>
                <Label text="Tìm bạn bằng số điện thoại, tạo nhóm và bắt đầu trò chuyện" styleClass="empty-state-sub"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
