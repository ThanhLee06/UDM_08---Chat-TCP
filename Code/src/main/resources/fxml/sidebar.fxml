<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.ut.udm08.client.ui.sidebar.SidebarController"
      styleClass="sidebar" minWidth="280" prefWidth="310" maxWidth="330">
    <fx:define><ToggleGroup fx:id="conversationTabs"/></fx:define>
    <VBox styleClass="sidebar-heading" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="6">
            <Label text="Tin nhắn" styleClass="sidebar-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="createGroupBtn" onAction="#createGroup" styleClass="sidebar-icon-btn" accessibleText="Tạo nhóm mới">
                <tooltip><Tooltip text="Tạo nhóm mới"/></tooltip>
            </Button>
            <Button fx:id="findPhoneBtn" onAction="#findByPhone" styleClass="sidebar-icon-btn" accessibleText="Tìm bạn bằng số điện thoại">
                <tooltip><Tooltip text="Tìm bạn qua số điện thoại"/></tooltip>
            </Button>
            <Button fx:id="refreshButton" onAction="#reload" styleClass="sidebar-icon-btn" accessibleText="Tải lại danh sách hội thoại">
                <tooltip><Tooltip text="Tải lại hội thoại"/></tooltip>
            </Button>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="currentUserLabel" styleClass="sidebar-account"/>
        </HBox>
        <HBox styleClass="sidebar-search-box" alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="searchIconLabel" styleClass="sidebar-search-icon"/>
            <TextField fx:id="searchField" promptText="Tìm kiếm..." styleClass="sidebar-search-input" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
    <HBox styleClass="sidebar-tabs" spacing="4">
        <ToggleButton fx:id="directTab" text="Đoạn chat" selected="true" toggleGroup="$conversationTabs" styleClass="sidebar-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="roomsTab" text="Đang online" toggleGroup="$conversationTabs" styleClass="sidebar-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label fx:id="conversationCount" styleClass="sidebar-count"/>
    <StackPane VBox.vgrow="ALWAYS">
        <ListView fx:id="conversationList" styleClass="conversation-list" accessibleText="Danh sách hội thoại"/>
        <VBox fx:id="statusPane" alignment="CENTER" spacing="12" styleClass="sidebar-state">
            <ProgressIndicator fx:id="loadingIndicator" prefWidth="28" prefHeight="28" maxWidth="28" maxHeight="28"/>
            <Label fx:id="statusTitle" styleClass="sidebar-state-title" wrapText="true"/>
            <Label fx:id="statusDetail" styleClass="sidebar-state-detail" wrapText="true"/>
            <Button fx:id="retryButton" text="Thử lại" onAction="#reload" styleClass="sidebar-retry"/>
        </VBox>
    </StackPane>
</VBox>

